{
  "name": "sam",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run dev -w @sam/bot",
    "dev:web": "npm run dev -w @sam/web",
    "build": "npm run build -w @sam/bot && npm run build -w @sam/web",
    "build:bot": "npm run build -w @sam/bot",
    "build:web": "npm run build -w @sam/web",
    "start": "npm run start -w @sam/bot",
    "seed": "npm run seed -w @sam/bot",
    "test": "npm run test -w @sam/bot",
    "coach": "npm run coach -w @sam/bot",
    "coach:auto": "npm run coach:auto -w @sam/bot",
    "research": "npx tsx --env-file .env.local scripts/batch-research.ts",
    "research:city": "npx tsx --env-file .env.local scripts/research-city.ts",
    "stress-test": "npx tsx scripts/stress-test.ts",
    "stress-test:adapt": "npx tsx scripts/stress-test-adapt.ts",
    "verify": "npx tsx --env-file .env.local scripts/verify-fixes.ts",
    "chat-test": "npx tsx --env-file .env.local scripts/chat-test.ts",
    "db-gap": "npx tsx --env-file .env.local scripts/db-gap-analysis.ts",
    "eval": "npx tsx --env-file .env.local scripts/scenario-eval.ts"
  }
}
